# ── School identity ──────────────────────────────────────────────────────────
DEFAULT_ADMIN_SCHOOL=Atatürk Anadolu Lisesi
DEFAULT_ADMIN_FULL_NAME=System Admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@school.example.com
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=optimark
POSTGRES_USER=optimark
POSTGRES_PASSWORD=change-me-strong-password

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── Security ──────────────────────────────────────────────────────────────────
PBKDF2_ITERATIONS=210000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the public URL of this deployment (used by the backend)
CORS_ALLOWED_ORIGINS=http://localhost

# ── Scan processing ───────────────────────────────────────────────────────────
# Max upload size for a scanned sheet, in bytes (default 20 MB).
MAX_SCAN_UPLOAD_BYTES=20971520
# Set to 1 to process scans synchronously inside the API (dev/debug only).
SCAN_INLINE=0

# ── Network ───────────────────────────────────────────────────────────────────
# Host port nginx will bind to
HTTP_PORT=80
